:root{
  --bg:#07101c;--panel:#0d1827;--panel2:#111f31;--border:#203148;--text:#eef5ff;--muted:#8da0b8;
  --accent:#5ee7b2;--accent2:#6ea8ff;--danger:#ff647c;--warn:#ffd166;--shadow:0 20px 60px rgba(0,0,0,.28)
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 70% -10%,#17304a 0,#07101c 38%);color:var(--text);font-family:"DM Sans",system-ui,sans-serif;min-height:100vh}
button,a{font:inherit}.app-shell{display:flex;min-height:100vh}.sidebar{width:248px;border-right:1px solid var(--border);background:rgba(6,15,26,.82);backdrop-filter:blur(18px);padding:24px 16px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh}
.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 28px}.brand-mark{height:40px;width:40px;border-radius:12px;background:linear-gradient(135deg,#5ee7b2,#5c8dff);display:grid;place-items:center;color:#06101b;font-family:"Space Grotesk";font-weight:800;position:relative}.brand-mark i{position:absolute;width:7px;height:7px;background:white;border-radius:50%;right:4px;top:4px}.brand strong{display:block;font-family:"Space Grotesk";font-size:19px}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:2px}
nav{display:grid;gap:6px}.nav-item{padding:11px 12px;border-radius:10px;color:var(--muted);text-decoration:none;font-size:13px;display:flex;gap:11px;align-items:center}.nav-item span{width:18px;text-align:center}.nav-item.active,.nav-item:hover{color:var(--text);background:#132237}.nav-item.active{box-shadow:inset 2px 0 var(--accent)}
.sidebar-bottom{margin-top:auto}.mini-status{display:flex;gap:10px;align-items:center;padding:13px;background:#0c1928;border:1px solid var(--border);border-radius:12px}.mini-status b,.mini-status small{display:block}.mini-status b{font-size:12px}.mini-status small{font-size:10px;color:var(--muted);margin-top:3px}.pulse{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;box-shadow:0 0 0 5px rgba(94,231,178,.09);animation:pulse 1.8s infinite}@keyframes pulse{50%{box-shadow:0 0 0 9px rgba(94,231,178,0)}}.version{color:#50627a;font-size:8px;letter-spacing:1.4px;margin:18px 4px 0}
.main{width:min(1500px,100%);margin:auto;padding:34px 38px 24px}.topbar{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:26px}.eyebrow,.section-label{font-size:9px;letter-spacing:1.8px;color:#69809b;font-weight:700}.topbar h1{font-family:"Space Grotesk";font-size:34px;letter-spacing:-1.3px;margin:5px 0 5px}.topbar p{color:var(--muted);margin:0;font-size:13px}.top-actions{display:flex;gap:10px;align-items:center}.system-chip,.route-badge,.verified,.signal-state,.tiny-live,.event-count{font-size:9px;letter-spacing:1.2px;font-weight:800}.system-chip{border:1px solid #244936;background:#0c1f1a;color:var(--accent);padding:9px 11px;border-radius:9px;display:flex;gap:8px;align-items:center}.ghost-btn,.secondary-btn{border:1px solid var(--border);background:#0d1827;color:#aabbd0;border-radius:9px;padding:9px 13px;cursor:pointer}.ghost-btn:hover,.secondary-btn:hover{border-color:#37506e;color:white}
.card{background:linear-gradient(145deg,rgba(15,29,46,.94),rgba(10,22,36,.94));border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.75fr);gap:16px}.map-card{overflow:hidden}.card-head{display:flex;justify-content:space-between;align-items:flex-start;padding:18px 18px 12px}.card-head h2{font-family:"Space Grotesk";font-size:16px;margin:4px 0 0}.route-badge{padding:6px 9px;border-radius:7px;color:#8095ad;background:#132136}.route-badge.live{color:var(--accent);background:#0d2920}
.city-map{height:405px;margin:0 12px 12px;border-radius:12px;overflow:hidden;position:relative;background:#091525;border:1px solid #1c2d43}.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(110,168,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(110,168,255,.035) 1px,transparent 1px);background-size:32px 32px}.road{position:absolute;background:#18283b;box-shadow:inset 0 1px #253b53,inset 0 -1px #253b53}.horizontal{height:82px;left:0;right:0}.r1{top:145px}.r2{top:302px}.vertical{width:82px;top:0;bottom:0}.v1{left:29%}.v2{left:68%}.road:after{content:"";position:absolute;left:0;right:0;top:50%;border-top:1px dashed #486078}.vertical:after{top:0;bottom:0;left:50%;right:auto;border-top:0;border-left:1px dashed #486078}.road-label{position:absolute;color:#40536b;font-size:8px;letter-spacing:1.3px;font-weight:700}.l1{top:159px;left:3%}.l2{top:316px;left:73%}.hospital{position:absolute;right:16px;top:25px;width:118px;padding:10px;border:1px solid #29415d;background:#0d1e31;border-radius:10px}.hospital span{display:grid;place-items:center;width:24px;height:24px;border-radius:7px;background:#143b35;color:var(--accent);font-weight:800;margin-bottom:6px}.hospital b,.hospital small{display:block}.hospital b{font-size:9px}.hospital small{color:#6d8199;font-size:8px;margin-top:3px}.signal-node{position:absolute;z-index:4;display:flex;align-items:center;gap:5px}.signal-node span{font-size:8px;color:#7f94aa;font-weight:800}.node-a{left:calc(29% - 18px);top:125px}.node-b{left:calc(68% - 18px);top:125px}.node-c{left:calc(68% - 18px);top:282px}.signal-box{width:12px;padding:2px;background:#07101a;border:1px solid #33465d;border-radius:5px}.light{display:block;width:6px;height:6px;border-radius:50%;margin:2px auto;background:#253448}.light.red.on{background:var(--danger);box-shadow:0 0 10px var(--danger)}.light.yellow.on{background:var(--warn);box-shadow:0 0 10px var(--warn)}.light.green.on{background:var(--accent);box-shadow:0 0 10px var(--accent)}.car{position:absolute;color:#70859c;font-size:15px;z-index:3;transition:left .3s linear}.car1{left:8%;top:177px}.car2{left:53%;top:341px}.car3{left:80%;top:105px}.ambulance{position:absolute;left:5%;top:178px;z-index:8;display:flex;gap:5px;align-items:center;background:#eaf5ff;color:#0b1827;border-radius:7px;padding:5px 7px;font-size:9px;font-weight:800;box-shadow:0 5px 18px rgba(0,0,0,.35);transition:left .08s linear}.ambulance span{background:#ef4e67;color:white;width:16px;height:16px;border-radius:4px;display:grid;place-items:center;font-size:9px}.ambulance b{font-size:8px}.map-overlay{position:absolute;left:12px;bottom:12px;display:flex;gap:7px;flex-wrap:wrap}.map-overlay div{background:rgba(7,16,28,.85);border:1px solid #23364d;border-radius:8px;padding:7px 8px;font-size:9px;color:#94a7bd}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:5px}.dot.live{background:var(--accent)}.dot.route{background:var(--accent2)}.map-controls{padding:0 18px 18px;display:flex;gap:9px}.primary-btn{border:0;background:linear-gradient(135deg,#5ee7b2,#3ecf9a);color:#06151a;border-radius:10px;padding:11px 15px;font-weight:800;cursor:pointer;box-shadow:0 8px 25px rgba(94,231,178,.12)}.primary-btn:hover{transform:translateY(-1px)}
.status-column{display:grid;gap:16px}.vehicle-main{display:flex;align-items:center;gap:12px;padding:4px 18px 14px}.vehicle-icon{font-size:34px}.vehicle-main b,.vehicle-main span{display:block}.vehicle-main span{font-size:10px;color:var(--muted);margin-top:3px}.verified{color:var(--accent);background:#0c2820;padding:6px 8px;border-radius:7px}.data-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--border)}.data-grid div{padding:11px 15px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)}.data-grid div:nth-child(even){border-right:0}.data-grid span,.data-grid b{display:block}.data-grid span{font-size:9px;color:#71869f}.data-grid b{font-size:11px;margin-top:3px}.signal-card{min-height:230px}.big-signal{display:flex;justify-content:center;gap:15px;padding:18px}.big-signal .light{width:35px;height:35px;border-radius:50%;background:#1d2a3b}.big-signal .light.on{background:currentColor}.big-signal #redLight{color:var(--danger)}.big-signal #yellowLight{color:var(--warn)}.big-signal #greenLight{color:var(--accent)}.safety-line{border-top:1px solid var(--border);padding:12px 18px;display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}.safety-line b{color:var(--accent)}
.metrics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}.metric{padding:16px}.metric span,.metric small{display:block;color:#70849c;font-size:9px;letter-spacing:1px}.metric strong{display:block;font-family:"Space Grotesk";font-size:24px;margin:7px 0 2px}.metric small{letter-spacing:0;font-size:9px}
.lower-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.control-card,.event-card{padding-bottom:15px}.tiny-live{color:var(--accent);display:flex;gap:6px;align-items:center}.pipeline{padding:4px 18px 12px}.step{display:flex;gap:11px;align-items:center;padding:9px;border:1px solid transparent;border-radius:10px;opacity:.5}.step.active{opacity:1;background:#0c211d;border-color:#1b4c3e}.step span{font-family:"Space Grotesk";font-size:9px;color:#647b94;width:22px}.step b,.step small{display:block}.step b{font-size:11px}.step small{color:#71869d;font-size:9px;margin-top:2px}.connector{height:10px;border-left:1px dashed #344b65;margin-left:19px}.alert-panel{margin:0 18px;padding:11px;border:1px solid #27405d;background:#0c1b2c;border-radius:10px;display:flex;align-items:center;gap:10px}.alert-icon{height:29px;width:29px;border-radius:8px;background:#13283e;display:grid;place-items:center;color:var(--accent2)}.alert-panel b,.alert-panel span{display:block}.alert-panel b{font-size:10px}.alert-panel span{font-size:9px;color:var(--muted);margin-top:2px}.alert-panel em{margin-left:auto;font-style:normal;font-size:8px;font-weight:800;color:#7288a1}.event-count{color:#657b93}.event-list{max-height:265px;overflow:auto;padding:0 18px}.empty-event{color:#60758e;font-size:11px;padding:22px 4px}.event{display:grid;grid-template-columns:64px 8px 1fr;gap:8px;align-items:start;padding:9px 0;border-bottom:1px solid #18283a;font-size:10px}.event time{color:#566d86}.event .bar{width:6px;height:6px;border-radius:50%;background:var(--accent);margin-top:3px}.event .msg{color:#a9bad0}.event strong{color:white}
.disclaimer{margin-top:16px;border:1px solid #2a3b50;background:#0b1725;padding:11px 13px;border-radius:10px;display:flex;gap:9px;color:#7389a2;font-size:9px;line-height:1.5}.disclaimer span{color:var(--accent2)}.disclaimer p{margin:0}.disclaimer b{color:#9eb0c5}footer{display:flex;justify-content:center;gap:8px;color:#40536a;font-size:8px;letter-spacing:1.4px;margin:20px 0 0}.toast{position:fixed;right:22px;bottom:22px;background:#132337;border:1px solid #2b4460;color:#eaf3ff;padding:11px 14px;border-radius:10px;font-size:10px;opacity:0;transform:translateY(10px);pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:1050px){.sidebar{width:205px}.main{padding:26px}.hero-grid,.lower-grid{grid-template-columns:1fr}.status-column{grid-template-columns:1fr 1fr}.metrics-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.sidebar{display:none}.main{padding:18px}.topbar{display:block}.top-actions{margin-top:14px}.topbar h1{font-size:27px}.metrics-grid,.status-column{grid-template-columns:1fr}.city-map{height:340px}.map-controls{flex-wrap:wrap}.primary-btn{flex:1}.lower-grid{grid-template-columns:1fr}}




const state = {
  running:false, paused:false, stage:0, progress:0, startTime:null, elapsed:0, priorityCount:0,
  timer:null, lastEvent:null
};

const $ = (id) => document.getElementById(id);
const ambulance = $("ambulance");
const map = $("cityMap");
const toast = $("toast");

function timeNow(){
  return new Date().toLocaleTimeString([], {hour:"2-digit", minute:"2-digit", second:"2-digit"});
}
function toastMsg(msg){
  toast.textContent = msg;
  toast.classList.add("show");
  setTimeout(()=>toast.classList.remove("show"), 2200);
}
function logEvent(message, important=false){
  const list = $("eventList");
  const empty = list.querySelector(".empty-event");
  if(empty) empty.remove();
  const row = document.createElement("div");
  row.className = "event";
  row.innerHTML = `<time>${timeNow()}</time><i class="bar"></i><div class="msg">${important?"<strong>":""}${message}${important?"</strong>":""}</div>`;
  list.prepend(row);
  $("eventCount").textContent = `${list.querySelectorAll(".event").length} events`;
}
function setStep(n){
  for(let i=1;i<=5;i++) $("step"+i).classList.toggle("active", i<=n);
}
function setLights(color){
  ["red","yellow","green"].forEach(x=>$(x+"Light").classList.remove("on"));
  if(color) $(color+"Light").classList.add("on");
  $("signalState").textContent = color ? color.toUpperCase() : "OFF";
}
function setNodeLights(node, color){
  const nodes = document.querySelectorAll(".signal-node");
  if(!nodes[node-1]) return;
  nodes[node-1].querySelectorAll(".light").forEach(l=>l.classList.remove("on"));
  const light=nodes[node-1].querySelector(".light."+color);
  if(light) light.classList.add("on");
}
function updateDistance(){
  const d=Math.max(0,2.8-state.progress*2.8);
  $("distance").textContent=d.toFixed(1)+" km";
}
function updateAmbulance(){
  const width=map.clientWidth;
  const left=Math.max(24, Math.min(width-145, 24 + state.progress*(width-190)));
  ambulance.style.left=left+"px";
}
function normalState(){
  setLights("red");
  setNodeLights(1,"red"); setNodeLights(2,"red"); setNodeLights(3,"red");
  $("signalTitle").textContent="J-01 · Normal";
  $("safetyStatus").textContent="READY";
  $("routeBadge").textContent="STANDBY";
  $("routeBadge").classList.remove("live");
  $("emergencyState").textContent="INACTIVE";
  $("nextJunction").textContent="J-01";
  $("trafficImpact").textContent="LOW";
  $("trafficAlert").innerHTML=`<div class="alert-icon">◉</div><div><b>Traffic control</b><span>Waiting for an emergency request.</span></div><em>STANDBY</em>`;
}
function start(){
  if(state.running && !state.paused) return;
  if(state.stage===5) reset();
  state.running=true; state.paused=false;
  if(!state.startTime) state.startTime=performance.now();
  $("startBtn").disabled=true;
  $("startBtn").style.opacity=".6";
  $("emergencyState").textContent="ACTIVE";
  $("routeBadge").textContent="PRIORITY ROUTE";
  $("routeBadge").classList.add("live");
  setStep(1);
  $("safetyStatus").textContent="CHECKING";
  logEvent("Emergency vehicle AMB-102 detected", true);
  logEvent("Authorized vehicle identity verified");
  $("trafficAlert").innerHTML=`<div class="alert-icon">!</div><div><b>Traffic control</b><span>Emergency request received and being evaluated.</span></div><em>VERIFYING</em>`;
  toastMsg("Emergency vehicle detected");
  state.lastEvent=performance.now();
  state.timer=setInterval(tick,80);
}
function tick(){
  if(state.paused) return;
  state.progress += 0.0045;
  updateAmbulance(); updateDistance();
  const p=state.progress;
  if(state.stage===0 && p>=.10){
    state.stage=1; setStep(2); $("safetyStatus").textContent="VERIFIED";
    logEvent("Authentication passed — AMB-102 is authorized");
  }
  if(state.stage===1 && p>=.27){
    state.stage=2; setStep(3); $("nextJunction").textContent="J-02";
    $("signalTitle").textContent="J-02 · Approaching";
    $("trafficAlert").innerHTML=`<div class="alert-icon">◉</div><div><b>Route intelligence</b><span>J-02 identified as next priority junction.</span></div><em>LOCATED</em>`;
    logEvent("Live location received — direction NORTH");
    logEvent("Next junction identified: J-02");
  }
  if(state.stage===2 && p>=.43){
    state.stage=3; setStep(4); state.priorityCount=1; $("priorityCount").textContent="1";
    $("safetyStatus").textContent="SAFE CHECK";
    $("trafficImpact").textContent="CONTROLLED";
    $("trafficAlert").innerHTML=`<div class="alert-icon">⚠</div><div><b>Traffic control</b><span>Priority request sent to J-02. Traffic personnel notified.</span></div><em>REQUESTED</em>`;
    logEvent("Priority request sent to J-02", true);
    logEvent("Traffic personnel alert dispatched");
    toastMsg("Priority corridor requested");
  }
  if(state.stage===3 && p>=.51){
    state.stage=4; setStep(5); setLights("yellow"); setNodeLights(2,"yellow");
    $("safetyStatus").textContent="TRANSITION";
    $("signalTitle").textContent="J-02 · Safe transition";
    $("trafficAlert").querySelector("span").textContent="Signal transition in progress — clearing cross traffic.";
    $("trafficAlert").querySelector("em").textContent="CAUTION";
    logEvent("Safety check passed — controlled signal transition");
  }
  if(state.stage===4 && p>=.60){
    state.stage=4.5; setLights("green"); setNodeLights(2,"green");
    $("safetyStatus").textContent="PRIORITY ACTIVE";
    $("signalTitle").textContent="J-02 · Priority GREEN";
    $("trafficAlert").innerHTML=`<div class="alert-icon">✓</div><div><b>Traffic control</b><span>Emergency corridor open. AMB-102 has priority.</span></div><em>ACTIVE</em>`;
    logEvent("J-02 priority GREEN activated", true);
    toastMsg("Emergency corridor open");
  }
  if(state.stage===4.5 && p>=.82){
    state.stage=4.8;
    logEvent("AMB-102 entering J-02 intersection");
    $("trafficAlert").querySelector("span").textContent="Emergency vehicle crossing the priority junction.";
  }
  if(state.stage===4.8 && p>=.94){
    state.stage=5;
    $("signalTitle").textContent="J-02 · Restoring";
    setLights("yellow"); setNodeLights(2,"yellow");
    $("safetyStatus").textContent="RESTORING";
    logEvent("Emergency vehicle cleared J-02", true);
    setTimeout(()=>{
      setLights("red"); setNodeLights(2,"red");
      $("safetyStatus").textContent="READY";
      $("signalTitle").textContent="J-02 · Normal";
      $("emergencyState").textContent="COMPLETE";
      $("trafficImpact").textContent="LOW";
      $("trafficAlert").innerHTML=`<div class="alert-icon">✓</div><div><b>Traffic control</b><span>Route cleared. Normal traffic flow restored.</span></div><em>CLEARED</em>`;
      logEvent("Normal traffic restored");
      finish();
    },1100);
  }
}
function finish(){
  clearInterval(state.timer); state.timer=null; state.running=false;
  const sec=((performance.now()-state.startTime)/1000);
  $("responseTime").textContent=sec.toFixed(1)+"s";
  $("timeSaved").textContent=Math.max(8,Math.round(sec*0.45))+"s";
  $("startBtn").disabled=false; $("startBtn").style.opacity="1";
  $("routeBadge").textContent="COMPLETE";
  $("routeBadge").classList.remove("live");
  toastMsg("Emergency passage complete");
}
function pause(){
  if(!state.running && !state.paused) return;
  state.paused=!state.paused;
  $("pauseBtn").textContent=state.paused?"▶ Resume":"Ⅱ Pause";
  $("trafficAlert").querySelector("em").textContent=state.paused?"PAUSED":"ACTIVE";
  toastMsg(state.paused?"Simulation paused":"Simulation resumed");
}
function reset(){
  clearInterval(state.timer); state.timer=null;
  state.running=false; state.paused=false; state.stage=0; state.progress=0; state.startTime=null; state.elapsed=0; state.priorityCount=0;
  $("startBtn").disabled=false; $("startBtn").style.opacity="1"; $("pauseBtn").textContent="Ⅱ Pause";
  $("priorityCount").textContent="0"; $("responseTime").textContent="—"; $("timeSaved").textContent="—";
  $("eventList").innerHTML='<div class="empty-event">Start the simulation to populate the live event stream.</div>';
  $("eventCount").textContent="0 events"; $("distance").textContent="2.8 km"; $("emergencyState").textContent="INACTIVE";
  $("nextJunction").textContent="J-01"; $("trafficImpact").textContent="LOW"; setStep(1); normalState(); updateAmbulance();
}
$("startBtn").addEventListener("click",start);
$("pauseBtn").addEventListener("click",pause);
$("resetBtn").addEventListener("click",reset);
window.addEventListener("resize",updateAmbulance);
reset();


# Smart Emergency Vehicle Priority System

Premium hackathon prototype for demonstrating an intelligent emergency-vehicle priority workflow.

## Demo

1. Open `index.html`.
2. Click **Start emergency simulation**.
3. Watch the ambulance move through the simulated city network.
4. Observe authentication, location tracking, junction identification, traffic alert, safe signal transition, priority green, and normal traffic restoration.
5. Use **Pause** and **Reset** during the demo.

## Features

- Premium responsive control-center UI
- Emergency vehicle detection simulation
- Authorized vehicle verification
- Live simulated distance and route
- Three-junction visual network
- Safe RED → YELLOW → GREEN transition
- Traffic-control alert panel
- Live event stream
- Response-time and estimated time-saved metrics
- Simulation controls

## Run locally

No build tools are required.

Open `index.html` directly in Chrome or Edge.

## GitHub Pages

Create a public GitHub repository, upload:
- `index.html`
- `style.css`
- `script.js`
- `README.md`

Then go to:

Settings → Pages → Deploy from a branch → `main` → `/ (root)` → Save.

GitHub will provide a public Pages URL.

## Important

This is a simulation prototype. It does not control real traffic infrastructure. Real deployment would require authorized integration with traffic-signal controllers, emergency services, secure authentication, communications, safety validation, and applicable regulations.

## Presentation line

“We are not claiming to reinvent the emergency siren. Our prototype demonstrates the coordination layer that connects an authenticated emergency vehicle with upcoming traffic-control points to create a safer, faster priority corridor.”
